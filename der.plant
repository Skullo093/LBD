@startuml der_leadforge
!theme plain
hide circle
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #006654
  HeaderBackgroundColor #006654
  FontColor #1E293B
  AttributeFontSize 12
}

title Diagrama Entidade-Relacionamento (DER) — LeadForge (3FN)

entity "usuario" as usuario {
  * id : SERIAL <<PK>>
  --
  * nome : VARCHAR(120)
  * email : VARCHAR(150) <<UK>>
  * senha_hash : VARCHAR(255)
  * aceite_lgpd : BOOLEAN
  * ativo : BOOLEAN
  * criado_em : TIMESTAMP
  * atualizado_em : TIMESTAMP
}

entity "perfil_freelancer" as perfil {
  * id : SERIAL <<PK>>
  --
  * usuario_id : INT <<FK, UK>>
  * cidade : VARCHAR(100)
  * estado : CHAR(2)
  * tom_comunicacao : VARCHAR(20)
  * atualizado_em : TIMESTAMP
}

entity "habilidade" as habilidade {
  * id : SERIAL <<PK>>
  --
  * nome : VARCHAR(60) <<UK>>
  * categoria : VARCHAR(30)
}

entity "perfil_habilidade" as perfil_habilidade {
  * perfil_id : INT <<PK, FK>>
  * habilidade_id : INT <<PK, FK>>
  --
  * nivel_proficiencia : VARCHAR(20)
}

entity "busca" as busca {
  * id : SERIAL <<PK>>
  --
  * usuario_id : INT <<FK>>
  * nicho : VARCHAR(100)
  * cidade : VARCHAR(100)
  * estado : CHAR(2)
  * limite_resultados : INT
  * status_busca : VARCHAR(20)
  * total_encontradas : INT
  * total_duplicadas : INT
  mensagem_erro : VARCHAR(255)
  * criada_em : TIMESTAMP
  finalizada_em : TIMESTAMP
}

entity "empresa" as empresa {
  * id : SERIAL <<PK>>
  --
  * external_place_id : VARCHAR(120) <<UK>>
  * nome : VARCHAR(160)
  * nicho : VARCHAR(100)
  * cidade : VARCHAR(100)
  * estado : CHAR(2)
  endereco : VARCHAR(255)
  telefone : VARCHAR(30)
  url_site : VARCHAR(255)
  * criada_em : TIMESTAMP
  * atualizada_em : TIMESTAMP
}

entity "evidencia" as evidencia {
  * id : SERIAL <<PK>>
  --
  * empresa_id : INT <<FK>>
  * tipo_evidencia : VARCHAR(35)
  * indica_problema : BOOLEAN
  * valor_detectado : VARCHAR(255)
  * nivel_certeza : VARCHAR(20)
  * origem_fonte : VARCHAR(120)
  * coletada_em : TIMESTAMP
}

entity "oportunidade" as oportunidade {
  * id : SERIAL <<PK>>
  --
  * usuario_id : INT <<FK, UK>>
  * empresa_id : INT <<FK, UK>>
  busca_id : INT <<FK>>
  * pontuacao : NUMERIC(5,2)
  * status_contato : VARCHAR(20)
  observacoes : TEXT
  * criada_em : TIMESTAMP
  * atualizada_em : TIMESTAMP
}

entity "sugestao_abordagem" as sugestao {
  * id : SERIAL <<PK>>
  --
  * oportunidade_id : INT <<FK, UK>>
  * texto_explicacao : TEXT
  * rascunho_mensagem : TEXT
  * modelo_ia : VARCHAR(50)
  * foi_editado : BOOLEAN
  * revisado_usuario : BOOLEAN
  * gerada_em : TIMESTAMP
  editada_em : TIMESTAMP
}

entity "auditoria_oportunidade_log" as auditoria {
  * id : SERIAL <<PK>>
  --
  * oportunidade_id : INT
  * usuario_id : INT
  * acao : VARCHAR(20)
  status_anterior : VARCHAR(20)
  status_novo : VARCHAR(20)
  pontuacao_anterior : NUMERIC(5,2)
  pontuacao_nova : NUMERIC(5,2)
  * registrado_em : TIMESTAMP
}

' Relacionamentos e Cardinalidades (Notação Pé de Galinha / IE)
usuario ||--|| perfil : "possui (1:1)"
perfil ||--o{ perfil_habilidade : "detém"
habilidade ||--o{ perfil_habilidade : "compõe"

usuario ||--o{ busca : "executa"
usuario ||--o{ oportunidade : "gerencia carteira"
empresa ||--o{ oportunidade : "prospectada em"
busca |o--o{ oportunidade : "origina"

empresa ||--o{ evidencia : "possui sinais"
oportunidade ||--o| sugestao : "recebe IA"
oportunidade ..> auditoria : "audita (Trigger)"

@enduml